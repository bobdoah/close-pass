# Externally-reachable URL of this service. Used for OAuth redirects.
PUBLIC_URL=http://nas.lan:8080

# Strava API credentials
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# YouTube Data API credentials (optional; required for upload feature)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: gate the web UI with basic auth
# BASIC_AUTH=close:pass

TZ=Europe/London
